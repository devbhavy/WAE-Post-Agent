# Your automation endpoint must accept the JSON payload documented in README.md.
SOCIAL_WEBHOOK_URL=https://your-automation-service.example/webhook/social
SOCIAL_WEBHOOK_TOKEN=your-webhook-secret

# Shared model for the combined agent, lead extraction, and social drafting.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
AGENT_TIMEZONE=Asia/Kolkata

# WhatsApp gateway and test-chat boundary.
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=your-openwa-api-key
OPENWA_SESSION_ID=your-linked-session-id
# Only this exact chat is processed. Blank/missing blocks all customer chats.
OPENWA_TEST_CHAT_ID=919876543210@c.us
# Temporary override: true processes all individual chats and groups.
OPENWA_ALLOW_ALL_CHATS=false
# Private owner notification chat; use a separate number you control.
OPENWA_OWNER_CHAT_ID=919876543210@c.us
OPENWA_WEBHOOK_SECRET=replace-with-a-long-random-secret
WHATSAPP_DB=whatsapp.sqlite3
# Separate UI API bearer token (not the OpenWA API key). Blank disables the UI API.
WHATSAPP_API_TOKEN=replace-with-a-random-private-token
# Exact browser UI origins, comma-separated. No wildcard and no trailing slash.
WHATSAPP_API_ORIGINS=http://localhost:3000,http://localhost:5173
